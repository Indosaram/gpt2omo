# ==============================================================================
# OMO Bridge Configuration
# ==============================================================================

# Network & Daemon Binding
OMO_BRIDGE_HOST=0.0.0.0
OMO_BRIDGE_PORT=18800
OMO_MOUNT_ROOT=/

# Bridge URL for Delegations & Relays (e.g., local daemon or Cloudflare Tunnel)
OMO_BRIDGE_URL=http://127.0.0.1:18800
# OMO_BRIDGE_URL=https://code.checka.cc

# Optional Bearer Token Authentication
# OMO_BRIDGE_TOKEN=your-secret-token-here

# Orca Browser Automation Settings
OMO_ORCA_BIN=orca
OMO_ORCA_WORKTREE=active
OMO_ORCA_PROFILE=default

# Session Retention & Lifecycle Policies (in minutes)
OMO_WEB_SESSION_TTL_MINUTES=120

# Workspace Root Override (defaults to auto-discovered git repository root)
# OMO_WORKSPACE=/Users/indo/code/project/my-app
