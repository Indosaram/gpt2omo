# ==============================================================================
# gpt2omo Configuration
# ==============================================================================

# Daemon HTTP/SSE bind address.
OMO_BRIDGE_BIND=127.0.0.1:18800

# Shared per-delegation scope directory. Leave unset to derive it from the bridge port.
# OMO_SCOPE_DIR=/tmp/gpt2omo/scopes-18800

# URLs used by the delegation helper and relay. HTTPS tunnel URLs are also supported.
OMO_BRIDGE_URL=http://127.0.0.1:18800
OMO_BRIDGE_EVENTS_URL=http://127.0.0.1:18800/events

# Optional Bearer token used by the daemon, delegation helper, and relay.
# OMO_BRIDGE_TOKEN=your-secret-token-here

# Optional retained-session controls.
OMO_WEB_SESSION_TTL_MINUTES=120
OMO_WEB_SESSION_GC_INTERVAL_SECS=60

# Optional fresh-workspace and legacy terminal selectors.
# OMO_WORKSPACE=/Users/indo/code/project/my-app
# OMO_RELAY_TERMINAL=terminal-handle

# Optional Pattern B advisory model. query_subagent is omitted unless the endpoint is set.
# OMO_SUBAGENT_ENDPOINT=http://127.0.0.1:8000
# OMO_SUBAGENT_API_KEY=your-subagent-api-key
OMO_SUBAGENT_MODEL=deepseek-v4-flash-free
OMO_SUBAGENT_ALLOW_REMOTE=false
