# ==============================================================================
# OMO Bridge configuration
# Source this file before launching the binaries: . ./.env.example
# ==============================================================================

# Daemon network binding. Keep loopback unless bearer auth and a trusted proxy are in place.
OMO_BRIDGE_BIND=127.0.0.1:18800

# Capability mount root. Prefer a project parent rather than the filesystem root.
OMO_MOUNT_ROOT=/

# Bridge URL used by delegate_to_chatgpt_web and omo-relay.
OMO_BRIDGE_URL=http://127.0.0.1:18800

# Required for any non-loopback bind.
OMO_BRIDGE_TOKEN=replace-with-a-long-random-secret

# Build/test commands execute with host privileges only when explicitly enabled and externally sandboxed.
OMO_BRIDGE_ALLOW_HOST_COMMAND_EXECUTION=false

# Persistent scope and lifecycle settings.
OMO_SCOPE_DIR=/tmp/omo-bridge-scopes
OMO_WEB_SESSION_TTL_MINUTES=120

# Delegate browser settings.
OMO_ORCA_BIN=orca
OMO_ORCA_WORKTREE=active
OMO_RELAY_TERMINAL=

# Optional limits.
OMO_WORKSPACE=
OMO_MAX_FILE_BYTES=10485760
OMO_COMMAND_TIMEOUT_MS=300000
